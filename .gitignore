###############################################################################
# UNIVERSAL .gitignore
# Purpose:
#   Portable, defensive baseline suitable for most repositories.
#
# Design:
#   - Ignore machine-local state
#   - Ignore credentials/secrets
#   - Ignore dependencies and generated artifacts
#   - Ignore build/test/cache output
#   - Ignore common IDE/editor state
#   - Ignore OS metadata
#   - Ignore common language/package-manager artifacts
#   - Avoid ignoring legitimate source/config files by default
#
# IMPORTANT:
#   This is intentionally comprehensive. Repository-specific rules may still
#   be required for unusual frameworks, generated assets, proprietary tooling,
#   or custom build systems.
###############################################################################


###############################################################################
# 01. OPERATING SYSTEM / FILESYSTEM JUNK
###############################################################################

# macOS
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.DocumentRevisions-V100
.fseventsd
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.stackdump

# Linux / desktop environments
.directory
.Trash-*
.nfs*

# Generic filesystem/editor lock files
*.swp
*.swo
*.swn
*.bak
*.tmp
*.temp
*.orig
*.rej
*~
.#*
#*#



{
  "name": "@the-federation/mcp-bridgelement",
  "version": "1.9.1",
  "description": "Global MCP Bridge for standalone applications and agent systems. Provides provider-neutral policy enforcement, identity, storage, and collection of telemetry data for RL, evaluation, analytics, replay, and downstream dataset generation. ChatGPT is one optional adapter, not the service identity.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/drdeeks/mcp-bridgelement.git"
  },
  "homepage": "https://github.com/The-Federation-Society/Federation-Society/tree/main/plugins/mcp-bridgelement",
  "bugs": {
    "url": "https://github.com/The-Federation-Society/Federation-Society/issues"
  },
  "keywords": [
    "mcp",
    "bridge",
    "cloudflare",
    "worker",
    "d1",
    "telemetry",
    "provider-agnostic"
  ],
  "dependencies": {
    "@drdeeks/character-kit-config-schema": "1.9.1",
    "@drdeeks/character-kit-core": "1.9.1",
    "@drdeeks/character-kit-events": "1.9.1",
    "@drdeeks/character-kit-mcp-contract": "1.9.1",
    "@drdeeks/character-kit-protocol": "1.9.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test src/*.test.js",
    "deploy:staging": "npx wrangler deploy --env staging",
    "deploy:production": "npx wrangler deploy --env production"
  }
}